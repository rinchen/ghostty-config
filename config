shell-integration-features = sudo,ssh-terminfo, ssh-env, title
font-family = "GeistMono Nerd Font"
# Use the Nerd Font symbols as a fallback
font-style = "Regular"
font-size = 14
window-padding-x = 10
window-padding-y = 10
window-width = 150
window-height = 60
window-colorspace = display-p3
background-opacity = 0.95
background-blur-radius = 20
macos-titlebar-style = native
theme = "Paul Millr"
#theme = "Builtin Dark"
# Explicitly enable Geist's texture healing and arrows
font-feature = +calt
font-feature = +liga
font-feature = +dlig
font-feature = +ss01
font-feature = +ss04
# Dims the terminal slightly when you click away to your browser
unfocused-split-opacity = 0.7